<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 700px;">
    <div class="mb-4">
        <a href="/books" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Back to Books</a>
        <h3 class="fw-bold mt-2"><i class="bi bi-plus-circle me-2 text-primary"></i>Add New Book</h3>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
    <% } %>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form action="/books/add" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="Book title" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Author <span class="text-danger">*</span></label>
                        <input type="text" name="author" class="form-control" placeholder="Author name" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <input type="text" name="category" class="form-control" placeholder="e.g. Fiction, Science" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">ISBN <span class="text-danger">*</span></label>
                        <input type="text" name="isbn" class="form-control" placeholder="e.g. 978-3-16-148410-0" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Publication Year <span class="text-danger">*</span></label>
                        <input type="number" name="publicationYear" class="form-control" placeholder="e.g. 2023" min="1000" max="2100" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Total Quantity <span class="text-danger">*</span></label>
                        <input type="number" name="quantity" class="form-control" placeholder="e.g. 5" min="0" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Available Copies <span class="text-danger">*</span></label>
                        <input type="number" name="availableCopies" class="form-control" placeholder="e.g. 5" min="0" required>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Add Book</button>
                    <a href="/books" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
