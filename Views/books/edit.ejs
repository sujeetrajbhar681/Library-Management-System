<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 700px;">
    <div class="mb-4">
        <a href="/books" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Back to Books</a>
        <h3 class="fw-bold mt-2"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Book</h3>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
    <% } %>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form action="/books/edit/<%= book._id %>?_method=PUT" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="<%= book.title %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Author <span class="text-danger">*</span></label>
                        <input type="text" name="author" class="form-control" value="<%= book.author %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <input type="text" name="category" class="form-control" value="<%= book.category %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">ISBN <span class="text-danger">*</span></label>
                        <input type="text" name="isbn" class="form-control" value="<%= book.isbn %>" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Publication Year <span class="text-danger">*</span></label>
                        <input type="number" name="publicationYear" class="form-control" value="<%= book.publicationYear %>" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Total Quantity <span class="text-danger">*</span></label>
                        <input type="number" name="quantity" class="form-control" value="<%= book.quantity %>" min="0" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Available Copies <span class="text-danger">*</span></label>
                        <input type="number" name="availableCopies" class="form-control" value="<%= book.availableCopies %>" min="0" required>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-warning px-4"><i class="bi bi-save me-1"></i>Update Book</button>
                    <a href="/books" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
