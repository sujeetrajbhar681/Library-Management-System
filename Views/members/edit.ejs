<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 700px;">
    <div class="mb-4">
        <a href="/members" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Back to Members</a>
        <h3 class="fw-bold mt-2"><i class="bi bi-person-gear me-2 text-warning"></i>Edit Member</h3>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
    <% } %>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form action="/members/edit/<%= member._id %>?_method=PUT" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" value="<%= member.name %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" value="<%= member.email %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                        <input type="text" name="mobile" class="form-control" value="<%= member.mobile %>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Membership Date <span class="text-danger">*</span></label>
                        <input type="date" name="membershipDate" class="form-control"
                               value="<%= new Date(member.membershipDate).toISOString().split('T')[0] %>" required>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">Address <span class="text-danger">*</span></label>
                        <textarea name="address" class="form-control" rows="3" required><%= member.address %></textarea>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-warning px-4"><i class="bi bi-save me-1"></i>Update Member</button>
                    <a href="/members" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
