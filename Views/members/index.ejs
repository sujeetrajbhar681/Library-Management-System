<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold"><i class="bi bi-people me-2 text-success"></i>Member Management</h3>
            <p class="text-muted mb-0">Manage library members</p>
        </div>
        <a href="/members/add" class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> Add New Member
        </a>
    </div>

    <!-- Alerts -->
    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form action="/members" method="GET" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" placeholder="Search by name..." value="<%= search %>">
                <button type="submit" class="btn btn-outline-success px-4"><i class="bi bi-search"></i></button>
                <% if (search) { %>
                    <a href="/members" class="btn btn-outline-secondary">Clear</a>
                <% } %>
            </form>
        </div>
    </div>

    <!-- Members Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <% if (members.length === 0) { %>
                <div class="text-center py-5">
                    <i class="bi bi-person-x text-muted fs-1"></i>
                    <p class="text-muted mt-3">
                        <% if (search) { %>No members found for "<%= search %>".<% } else { %>No members registered yet.<% } %>
                    </p>
                    <a href="/members/add" class="btn btn-success btn-sm">Add First Member</a>
                </div>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Address</th>
                            <th>Membership Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% members.forEach((member, index) => { %>
                        <tr>
                            <td class="text-muted"><%= index + 1 %></td>
                            <td class="fw-semibold">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center"
                                         style="width:36px;height:36px;font-weight:600;">
                                        <%= member.name.charAt(0).toUpperCase() %>
                                    </div>
                                    <%= member.name %>
                                </div>
                            </td>
                            <td class="text-muted small"><%= member.email %></td>
                            <td><%= member.mobile %></td>
                            <td class="text-muted small"><%= member.address %></td>
                            <td><%= new Date(member.membershipDate).toLocaleDateString('en-IN') %></td>
                            <td>
                                <a href="/members/edit/<%= member._id %>" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/members/delete/<%= member._id %>?_method=DELETE" method="POST" class="d-inline"
                                      onsubmit="return confirm('Delete this member?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 text-muted small">Showing <%= members.length %> member(s)</div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
