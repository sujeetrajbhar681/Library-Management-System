<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold"><i class="bi bi-journals me-2 text-primary"></i>Book Management</h3>
            <p class="text-muted mb-0">Manage your library book collection</p>
        </div>
        <a href="/books/add" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add New Book
        </a>
    </div>

    <!-- Alerts -->
    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form action="/books" method="GET" class="d-flex gap-2">
                <input type="text" name="search" class="form-control" placeholder="Search by title..." value="<%= search %>">
                <button type="submit" class="btn btn-outline-primary px-4"><i class="bi bi-search"></i></button>
                <% if (search) { %>
                    <a href="/books" class="btn btn-outline-secondary">Clear</a>
                <% } %>
            </form>
        </div>
    </div>

    <!-- Books Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <% if (books.length === 0) { %>
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted fs-1"></i>
                    <p class="text-muted mt-3">
                        <% if (search) { %>No books found for "<%= search %>".<% } else { %>No books in the library yet.<% } %>
                    </p>
                    <a href="/books/add" class="btn btn-primary btn-sm">Add First Book</a>
                </div>
            <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>ISBN</th>
                            <th>Year</th>
                            <th>Qty</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% books.forEach((book, index) => { %>
                        <tr>
                            <td class="text-muted"><%= index + 1 %></td>
                            <td class="fw-semibold"><%= book.title %></td>
                            <td><%= book.author %></td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary"><%= book.category %></span></td>
                            <td class="text-muted small"><%= book.isbn %></td>
                            <td><%= book.publicationYear %></td>
                            <td><%= book.quantity %></td>
                            <td>
                                <span class="badge <%= book.availableCopies > 0 ? 'bg-success' : 'bg-danger' %>">
                                    <%= book.availableCopies %>
                                </span>
                            </td>
                            <td>
                                <a href="/books/edit/<%= book._id %>" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/books/delete/<%= book._id %>?_method=DELETE" method="POST" class="d-inline"
                                      onsubmit="return confirm('Delete this book?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 text-muted small">Showing <%= books.length %> book(s)</div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
